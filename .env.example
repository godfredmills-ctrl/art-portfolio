# ── Database ──────────────────────────────────────────────
# On Railway, reference the Postgres service: ${{Postgres.DATABASE_URL}}
DATABASE_URL="postgresql://user:password@localhost:5432/art_portfolio"
# Max pooled connections per app instance (use 1 with the single-connection `prisma dev` server).
DATABASE_POOL_MAX="10"

# ── Auth ──────────────────────────────────────────────────
# Long random string used to sign admin sessions.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=""

# Initial admin account, created by the seed only if no users exist yet.
ADMIN_EMAIL="you@example.com"
ADMIN_PASSWORD=""

# ── Site ──────────────────────────────────────────────────
# Public URL, used for SEO metadata and the sitemap. Optional: when unset, the
# Railway domain or the incoming request's host is used.
SITE_URL="http://localhost:3000"

# Seed demo categories and artworks (with generated images) on an empty database.
SEED_DEMO_CONTENT="false"

# ── Media storage ─────────────────────────────────────────
# "local": files stored on disk. On Railway, attach a Volume (e.g. mounted at /data)
#          and set UPLOAD_DIR=/data/uploads so files survive redeploys.
# "s3":    any S3-compatible bucket (Railway Buckets, AWS S3, Cloudflare R2, ...).
STORAGE_DRIVER="local"
UPLOAD_DIR="./.data/uploads"

# Only for STORAGE_DRIVER=s3
S3_ENDPOINT=""
S3_REGION="auto"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_FORCE_PATH_STYLE="false"
